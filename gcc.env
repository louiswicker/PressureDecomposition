# site settings for making CM1 and PDcomp on Linux machines 
#

# these need the netcdf bins in your path, probably from miniconda3 env

NETCDF=`nc-config --prefix`
NETCDF_INC=`nc-config --includedir`
NETCDF_LIB=`nf-config --flibs`

# used in compiler CM1 code (may not be needed)

OUTPUTOPT = -DNETCDF -DNCFPLUS

OUTPUTINC = -I${NETCDF_INC}

LINKOPTS = -L${NETCDF_LIB}

#FC   = mpif90
#OPTS = -ffree-form -ffree-line-length-none -O2 -finline-functions
#CPP  = cpp -C -P -traditional -Wno-invalid-pp-token -ffreestanding
#DM   = -DMPI -DHDD

FC   = gfortran
OPTS = -ffree-form -ffree-line-length-none -O2 -finline-functions -fopenmp
CPP  = cpp -C -P -traditional -Wno-invalid-pp-token -ffreestanding
OMP  = -DOPENMP -DHDD
